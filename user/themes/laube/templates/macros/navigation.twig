{% macro loop(page) %}
    {% import _self as nav %}
    {% for p in page.children.visible %}
        {% set classes = [] %}
        {% if p.active or p.activeChild %}
            {% set classes = classes|merge([ 'active' ]) %}
        {% endif %}
        {% if p.header.menu_classes %}
            {% set classes = classes|merge([ p.header.menu_classes ]) %}
        {% endif %}
        <li class="item {{ classes|join( ' ' ) }}">
            <a class="link" href="{{ p.url }}"{% if p.active %} aria-current="page"{% endif %}>
                {{ p.menu }}
            </a>
        </li>
    {% endfor %}
{% endmacro %}