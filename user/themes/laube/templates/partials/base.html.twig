{% spaceless %}
{%- set body_classes = [
    body_classes|default( '' ),
    tpl_body_classes|default(''),
    header.body_classes,
]|join( ' ' )|trim -%}
{%- set theme_config = attribute(config.themes, config.system.pages.theme) -%}

{%- set doc_title = '' -%}
{% if header.title and page.slug != 'home' %}
    {%- set doc_title = header.title|e('html') ~ ' - ' -%}
{% endif %}
{% if title_overwrite != null %}
    {%- set doc_title = title_overwrite ~ ' - ' -%}
{% endif %}
{%- set doc_title = doc_title ~ site.title|e('html') -%}
{% endspaceless %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}" class="no-js">
<head>
{% block head %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ doc_title }}</title>

    {% include 'partials/metadata.html.twig' %}
    <link rel="canonical" href="{{ page.url(true, true) }}">
{% endblock head %}

<script type="module">
    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');
</script>

{% block stylesheets -%}
    {% do assets.addCss('theme://dist/css/main.css', 100) %}
    {%- if page.header.page_css %}
        {% do assets.addCss('theme://dist/css/' ~ page.header.page_css ~ '.css', 99) %}
    {% endif -%}
{% endblock -%}

<link rel="stylesheet"
    href="{{ url( 'theme://dist/css/fonts.css' )}}"
    media="print" onload="this.media='all'">
<noscript>
    <link rel="stylesheet" href="{{ url( 'theme://dist/css/fonts.css' )}}">
</noscript>

{% block javascripts %}
    {# ES modules are deferred by default. Never pipeline them: chunks are loaded relative to main.js #}
    {% do assets.addJsModule('theme://dist/js/main.js', { priority: 101, pipeline: false }) %}
    {% if config.site.env.state == 'dev' %}
        {% do assets.addJsModule('theme://dist/js/dev.js', { pipeline: false }) %}
    {% endif %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}

{%- if config.site.env.state == 'production' %}
    {# {% include 'partials/matomo.html.twig' %} #}
{% else %}
    <link rel="icon" href="{{ url('theme://assets/favicons/favicon.php') }}?letter={{ site.title|first }}&env={{ config.site.env.state }}">
    <meta name="robots" content="noindex,nofollow">
{% endif -%}

</head>
<body id="top" class="{{ body_classes }}">

{% block header %}
    <header class="header wrapping">
        <a href="#content" class="skiplink visually-hidden">{{ 'THEME_C.A11Y.SKIP2CONTENT'|t|e }}</a>

        <div class="wrapped">
            <a class="logo" href="{{ home_url }}">
                {{ svg('theme://dist/img/logo-multi.svg', 'logo__img icon')|raw }}
                {{ site.title }}
            </a>

            {% block header_navigation %}
                {% include 'partials/navigation.html.twig' %}
            {% endblock %}
            {% block langswitcher %}
                {% include 'partials/langswitcher.html.twig' %}
            {% endblock %}
        </div>
    </header>
{% endblock %}

<main class="main" id="content">
    {# {% block hero %}
        {% if page.header.hero.image %}
            {% include 'partials/hero.html.twig' %}
        {% endif %}
    {% endblock %} #}

    {% block breadcrumbs %}
        {% if config.plugins.breadcrumbs.enabled and page.header.hide_breadcrumbs == false %}
            {% include 'partials/breadcrumbs.html.twig' %}
        {% endif %}
    {% endblock %}

    {% block body %}
        {% block content %}{% endblock %}
    {% endblock %}
</main>

{% block footer %}
    <footer class="footer wrapping" id="footer">
        <div class="wrapped">
            <a href="#top" class="elevator" title="{{ 'THEME_C.A11Y.SKIP2TOP'|t|e }}">
                {{ 'THEME_C.A11Y.SKIP2TOP'|t|e }}
            </a>

            <nav class="footer__nav" aria-label="{{ 'THEME_C.NAV.FOOTER'|t|e }}">
                <ul class="menu">
                {% for item in site.footer.menu %}
                    <li class="item">
                        <a href="{{ item.url }}" class="link">{{ item.title }}</a>
                    </li>
                {% endfor %}
                </ul>
            </nav>

            <aside class="quote" lang="en" aria-hidden="true">{{ laube.qotm() }}</aside>

            {% include 'partials/social.html.twig' %}
        </div>
    </footer>
{% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}

</body>
</html>
