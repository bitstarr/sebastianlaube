{% if site.footer.social %}
    <ul class="social" aria-label="{{ 'THEME_C.NAV.SOCIAL'|t|e }}">
    {% for item in site.footer.social %}
        <li class="item">
            <a href="{{ item.url }}" rel="me" class="link" style="--brand: var( --brand-{{ item.icon }} )">
                {{ svg( item.icon )|raw }}
                <span class="vh">{{ item.title }}</span>
            </a>
        </li>
    {% endfor %}
    </ul>
{% endif %}